DB_HOST=your-postgres-host
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PORT=5432
DB_PASSWORD=your-database-password
# Defaults to require; use disable only for local PostgreSQL without SSL.
DB_SSLMODE=require

# Used by dashboard/app_real.py. Use the deployed API service URL in production.
API_URL=http://127.0.0.1:8000
